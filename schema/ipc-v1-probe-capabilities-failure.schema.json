{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guard-wall.local/schema/ipc-v1-probe-capabilities-failure.schema.json",
  "title": "Guard Wall Agent/Enforcer IPC v1 ProbeCapabilities Failure Response",
  "description": "The authoritative fail-closed failure schema for ProbeCapabilities. Successful capability payloads are defined by the separate success schema.",
  "x-guard-max-frame-bytes": 1048576,
  "x-guard-max-response-bytes": 4096,
  "x-guard-max-instance-depth": 2,
  "x-guard-max-json-tokens": 64,
  "type": "object",
  "additionalProperties": false,
  "maxProperties": 3,
  "required": ["version", "operation", "error_code"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "minimum": 1,
      "maximum": 1
    },
    "operation": {
      "type": "string",
      "const": "ProbeCapabilities",
      "maxLength": 32
    },
    "error_code": {
      "type": "string",
      "enum": ["unsupported", "not_ready"],
      "maxLength": 32
    }
  }
}
