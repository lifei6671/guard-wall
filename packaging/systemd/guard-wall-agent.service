[Unit]
Description=GuardWall unprivileged agent
Requires=guard-wall-core.service
After=guard-wall-core.service

[Service]
Type=exec
User=guard
Group=guard
ExecStart=/usr/local/bin/guard-wall-agent --config /etc/guard/guard-wall.yaml
SyslogIdentifier=guard-wall-agent
StateDirectory=guard
StateDirectoryMode=0750
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
# StateDirectory=guard creates /var/lib/guard as guard:guard; the agent never writes /etc/guard.
ReadWritePaths=/var/lib/guard
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
