[Unit]
Description=GuardWall privileged firewall core
After=network.target
Before=guard-wall-agent.service

[Service]
Type=exec
User=root
Group=guard
SupplementaryGroups=guard
ExecStart=/usr/local/bin/guard-wall-core
SyslogIdentifier=guard-wall-core
RuntimeDirectory=guard
RuntimeDirectoryMode=0750
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
# systemd creates /run/guard as root:guard 0750 before the sandbox is applied.
# The listener then validates the directory and creates the fixed socket.
ReadWritePaths=/run/guard
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
